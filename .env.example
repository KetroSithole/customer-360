# Copy this file to .env and adjust the values for your machine.
# .env is git-ignored, so credentials never end up in the repo.

# SQL Server instance (host\instance or host,port)
MSSQL_SERVER=GHOST\MSSQLSERVER02

# Target database for the raw tables and dbt models
MSSQL_DATABASE=CaseStudyDB

# ODBC driver installed on this machine
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Base schema used by dbt (staging/intermediate/marts are derived from it)
DBT_SCHEMA=analytics
